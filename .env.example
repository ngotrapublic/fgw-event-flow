# ========================================================
# Antigravity Application — Environment Configuration
# ========================================================
# Copy this file to '.env' in the root directory before running:
#   docker compose up -d

# --- Server Port & Environment ---
PORT=5000
NODE_ENV=production

# --- Firebase Service Account Credentials (REQUIRED) ---
# Obtain these from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- SMTP / Email Credentials (REQUIRED for Email Notifications) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# --- Reverse Proxy & Transport Security ---
# Required in production: set to the exact trusted reverse-proxy hop/subnet (e.g. "loopback" for host Nginx,
# or proxy container CIDR like "127.0.0.1,172.18.0.0/16") and firewall direct access to backend port 5000.
TRUST_PROXY=loopback
# Docker host bind IP (127.0.0.1 keeps Node unreachable directly from the Internet behind TLS Nginx)
DOCKER_BIND_IP=127.0.0.1

# --- Borrow Module HMAC Secret (REQUIRED in production, min 32 bytes random hex/base64) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BORROW_HMAC_SECRET=

# --- Security / CORS ---
# Comma-separated list of allowed origins for external API clients.
# Single-container deployment serves React on the same origin automatically.
ALLOWED_ORIGINS=https://event.greenwichvietnam.edu.vn,http://localhost:5000,http://localhost:5173

# --- Public URL used in borrow emails & QR station (no trailing slash; MUST be https:// in production) ---
APP_PUBLIC_URL=https://event.greenwichvietnam.edu.vn
