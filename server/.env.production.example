# =========================================
# BACKEND ENVIRONMENT CONFIGURATION
# Environment: PRODUCTION
# Copy to .env.production (or root .env) and fill real secrets
# =========================================

NODE_ENV=production
PORT=5000
LOG_LEVEL=warn

# Firebase (Production Project)
FIREBASE_PROJECT_ID=your-production-project-id
FIREBASE_CLIENT_EMAIL=your-prod-service-account@your-production-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRODUCTION_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Email (Production SMTP)
EMAIL_USER=noreply@your-domain.com
EMAIL_PASS=your-production-app-password
EMAIL_FROM="Event Management System <noreply@your-domain.com>"

# Reverse Proxy, Transport Security & CORS (REQUIRED in production)
TRUST_PROXY=loopback
ALLOWED_ORIGINS=https://event.greenwichvietnam.edu.vn
APP_PUBLIC_URL=https://event.greenwichvietnam.edu.vn

# Borrow Module HMAC Secret (REQUIRED in production, >= 32 random bytes, unique per environment)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BORROW_HMAC_SECRET=

# API Settings
API_RATE_LIMIT=100

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_AUDIT_LOGGING=true
