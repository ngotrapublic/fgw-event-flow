# ===========================================
# Antigravity — Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.

# --- Server ---
PORT=5000
NODE_ENV=production

# --- Firebase (Required) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="your-private-key"

# --- Email / SMTP (Required for notifications) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# --- Reverse Proxy & Transport Security ---
# Set TRUST_PROXY to trusted proxy IP/subnet (e.g. "loopback" when Nginx terminates TLS on same host,
# or reverse-proxy CIDR in containerized setup) and firewall backend port 5000 from direct access.
TRUST_PROXY=loopback

# --- Borrow Module HMAC Secret (REQUIRED in production, >= 32 random bytes, never share across envs) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BORROW_HMAC_SECRET=

# --- CORS ---
# Comma-separated list of allowed origins.
# In Docker (single container), frontend is served by the same Express server,
# so this is only needed for external API consumers.
ALLOWED_ORIGINS=https://event.greenwichvietnam.edu.vn,http://localhost:5173,http://localhost:3000

# --- Puppeteer (Docker only, set automatically in Dockerfile) ---
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# --- AI Agent (Gemini) ---
GEMINI_API_KEY="your-gemini-api-key"

# --- Public URL used in borrow emails & QR station (no trailing slash; MUST be https:// in production) ---
APP_PUBLIC_URL=https://event.greenwichvietnam.edu.vn
