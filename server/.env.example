# ===========================================
# Antigravity — Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.

# --- Server ---
PORT=5000
NODE_ENV=production

# --- Firebase (Required) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="your-private-key"

# --- Email / SMTP (Required for notifications) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# --- CORS ---
# Comma-separated list of allowed origins.
# In Docker (single container), frontend is served by the same Express server,
# so this is only needed for external API consumers.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Puppeteer (Docker only, set automatically in Dockerfile) ---
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
