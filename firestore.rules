rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check roles
    function hasRole(role) {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // User Profile: users can read their own profile.
    // The client never writes user docs; role/department/email changes
    // go through the Admin SDK (server) only — prevents privilege escalation
    // (role) and scope spoofing (department drives "My Events" stats).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Events: Authenticated users can read, only Managers/Admins can write.
    // (Event creation for regular users goes through the server API / Admin SDK.)
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if hasRole('admin') || hasRole('manager');
    }
    
    // Departments/Locations: Read all, Write Admin/Manager
    match /departments/{docId} {
      allow read: if request.auth != null;
      allow write: if hasRole('admin') || hasRole('manager');
    }
    match /locations/{docId} {
      allow read: if request.auth != null;
      allow write: if hasRole('admin') || hasRole('manager');
    }

    // Notifications: client reads/updates/deletes its OWN notifications
    // directly via Firestore SDK (markAsRead, markAllAsRead, clearAll).
    // Creation happens server-side via Admin SDK.
    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if false;
    }

    // Default catch-all: read-only for authenticated users.
    // All server-side writes use the Admin SDK which bypasses rules.
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
